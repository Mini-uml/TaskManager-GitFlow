@model TaskManager.Models.TaskItem


<h1>Nueva Tarea</h1>


<form asp-action="Create" method="post">


    <div class="mb-3">

        <label>Título</label>

        <input asp-for="Title"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label>Descripción</label>

<textarea asp-for="Description"
          class="form-control"></textarea>

    </div>


    <div class="mb-3">

        <label>
            <input asp-for="Completed" />
            Completada
        </label>

    </div>


    <button class="btn btn-success">
        Guardar
    </button>


    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>


</form>