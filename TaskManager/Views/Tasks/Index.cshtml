@model IEnumerable<TaskManager.Models.TaskItem>

<div class="text-center mb-4">

    <h1 class="display-5">
        Gestión de Tareas
    </h1>

    <p class="text-muted">
        Administra tus tareas pendientes y completadas
    </p>

</div>


<div class="mb-3">

    <a asp-action="Index"
       class="btn btn-secondary">
        Todas
    </a>


    <a asp-action="Index"
       asp-route-filter="pending"
       class="btn btn-warning">
        Pendientes
    </a>


    <a asp-action="Index"
       asp-route-filter="completed"
       class="btn btn-success">
        Completadas
    </a>


    <a asp-action="Create"
       class="btn btn-primary float-end">
        Nueva tarea
    </a>

</div>



<table class="table table-bordered table-striped mt-4">

    <thead class="table-dark">

        <tr>

            <th>
                Título
            </th>

            <th>
                Descripción
            </th>

            <th>
                Estado
            </th>

            <th>
                Acciones
            </th>

        </tr>

    </thead>


    <tbody>

        @foreach (var item in Model)
        {

            <tr>

                <td>
                    @item.Title
                </td>


                <td>
                    @item.Description
                </td>


                <td>

                    @if (item.Completed)
                    {
                        <span class="badge bg-success">
                            Completada
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            Pendiente
                        </span>
                    }

                </td>


                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">

                        Editar

                    </a>


                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">

                        Eliminar

                    </a>

                </td>


            </tr>

        }

    </tbody>


</table>